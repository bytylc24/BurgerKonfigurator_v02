<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>

<!-- Hauptfenster: TabPane mit den drei Seiten, jede Seite ist eine eigene FXML-Datei -->
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="at.htl.burgerkonfigurator.controller.MainController"
            stylesheets="@style.css">

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="Konfigurator">
                    <content>
                        <fx:include source="konfigurator.fxml"/>
                    </content>
                </Tab>

                <Tab text="Meine Burger">
                    <content>
                        <fx:include source="meine-burger.fxml"/>
                    </content>
                </Tab>

                <Tab text="Bestellhistorie">
                    <content>
                        <fx:include source="historie.fxml"/>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
