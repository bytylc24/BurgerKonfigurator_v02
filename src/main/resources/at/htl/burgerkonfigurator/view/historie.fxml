<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<!-- Bestellhistorie: alle Bestellungen, die neueste oben -->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="at.htl.burgerkonfigurator.controller.HistorieController"
      spacing="14" styleClass="page">

    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

    <Label text="Bestellhistorie" styleClass="page-title"/>
    <Label text="Hier findest du deine bisherigen Bestellungen." styleClass="subtitle"/>

    <TableView fx:id="historieTabelle" prefHeight="360" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="datumSpalte" text="Datum" prefWidth="160"/>
            <TableColumn fx:id="burgerSpalte" text="Burger" prefWidth="480"/>
            <TableColumn fx:id="gesamtpreisSpalte" text="Gesamtpreis" prefWidth="120"/>
        </columns>
        <placeholder>
            <Label text="Noch keine Bestellungen vorhanden."/>
        </placeholder>
    </TableView>
</VBox>
